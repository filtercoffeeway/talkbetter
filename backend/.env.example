# Copy this file to `.env` (start.sh does it for you) and fill in what you need.
# Nothing here is required: without keys you still get transcription, pace,
# fillers and local accent scoring. An ANTHROPIC_API_KEY adds grammar, clarity,
# and the confidence / thinking scores used by the 30-day program.

# ---- App ----
APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173   # Vite dev server
# Save read-aloud audio to data/recordings/ (for replay / comparing providers)
SAVE_RECORDINGS=false

# ---- Whisper (Phase 1) ----
# tiny | base | small | medium | large-v3  (bigger = slower, more accurate)
# small (~500 MB) is a good balance on a laptop CPU; large-v3 (~3 GB) is the most
# accurate but can take a minute per recording on CPU.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu                   # "cpu" or "cuda"
WHISPER_COMPUTE_TYPE=int8            # int8 (cpu) | float16 (gpu)

# ---- LLM for grammar, clarity, confidence + thinking scores (Phase 2) ----
# Get a key at https://console.anthropic.com . claude-haiku-4-5 is a cheaper,
# faster alternative; Sonnet judges confidence and structure more reliably.
# Tip: pick one and keep it for your whole 30 days so scores stay comparable.
LLM_PROVIDER=anthropic               # "anthropic" or "openai"
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# ---- American-accent scoring (Phase 3) ----
# "local" = on-device, no key (needs espeak-ng + ffmpeg; downloads a ~1.2 GB
#           phoneme model on first use). Judges how American you sound.
# "azure" = Azure Pronunciation Assessment. Judges how understandable you are —
#           noticeably more lenient about accent.
PRONUNCIATION_PROVIDER=local
# PRONUNCIATION_MODEL=facebook/wav2vec2-lv-60-espeak-cv-ft
# ESPEAK_VOICE=en-us
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=                 # e.g. eastus
