# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Env / secrets
.env
backend/.env

# Node / React
node_modules/
frontend/dist/
frontend/.vite/

# Model caches (downloaded at runtime). Anchored to the repo root so it doesn't
# also hide backend/app/models/ (the API schemas).
/models/
*.bin

# User audio data (do not commit recordings)
data/recordings/*
!data/recordings/.gitkeep

# Local progress DB (per-machine, contains personal practice history)
data/*.db
data/*.db.*
data/*.db-*

# OS / editor
.DS_Store
.idea/
.vscode/
*.log

# Runtime PIDs from start.sh
.pids

# Local credentials scratch file
secrets.txt
